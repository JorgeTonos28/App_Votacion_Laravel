APP_NAME=InnovaMente
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tu-dominio.com

BOOTSTRAP_ADMIN_EMAIL=admin@tu-dominio.com
BOOTSTRAP_ADMIN_PASSWORD=cambia-esta-contrasena
BOOTSTRAP_ADMIN_NAME="Administrador InnovaMente"
DEMO_JUROR_CODE=J7K4-PQ9M

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES
APP_TIMEZONE=America/Santo_Domingo

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# Usa aquí exactamente los datos creados en cPanel > MySQL Databases.
# En muchos hostings el nombre real incluye el prefijo de la cuenta.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cuenta_innovamente
DB_USERNAME=cuenta_innovamente
DB_PASSWORD=pon-aqui-la-contrasena
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
